{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/orders", "destination": "/orders/sales-orders/index.html" },
    { "source": "/accounts", "destination": "/accounts/index.html" }
  ],
  "functions": {
    "api/public/products/index.js":               { "memory": 2048 },
    "api/despatches/[id]/status.js":              { "memory": 2048 },
    "api/despatches/[id]/push-to-xero.js":        { "memory": 2048 },
    "api/despatches/[id]/archive-to-onedrive.js": { "memory": 2048 },
    "api/accounts/revolut-sync.js":               { "memory": 2048, "maxDuration": 60 }
  }
}
